@{ ViewData["Title"] = "Dashboard"; }
<h1>Welcome to RaceDay!</h1>
<p>You are logged in as: <strong>@User.Identity.Name (@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value)</strong></p>
<a asp-controller="Account" asp-action="Logout" class="btn btn-danger">Logout</a>