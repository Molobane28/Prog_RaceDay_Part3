@model IEnumerable<RaceDay.MVC.Models.EventViewModel>
@{ ViewData["Title"] = "Organiser Dashboard"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>My Events</h2>
    <a asp-action="CreateEvent" class="btn btn-success">+ Create New Event</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Type</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.EventName</td>
                    <td>@ev.EventDate.ToString("yyyy-MM-dd")</td>
                    <td>@ev.Location</td>
                    <td>@ev.EventType</td>
                    <td><span class="badge bg-primary">@ev.Status</span></td>
                    <td>
                        <a href="#" class="btn btn-sm btn-outline-primary">View Enrolments</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}